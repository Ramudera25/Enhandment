# Misi uji standar untuk benchmark sebelum/sesudah (aman: hanya navigasi
# Pengaturan Wi-Fi; teks uji ditempel di formulir Add network lalu formulir
# dibuang dengan tombol back — pola uji isi formulir 8 Okt; langkah isi memakai ISI_TEKS sejak
# koreksi spec 9 Okt (TEMPEL terbukti tidak punya toolbar tempel di
# formulir ini — vonis perangkat 9 Okt; TEMPEL tetap ada untuk
# formulir yang memang menampilkannya); tidak mengubah data).
TARGET com.android.settings
BUKA android.settings.WIFI_SETTINGS
TUNGGU_TEKS "Add network" 20
KETUK_TEKS "Add network"
TUNGGU_TEKS "Network name" 20
CEK_TEKS "Network name"
ISI_TEKS "MUSEUJI"
CEK_TEKS "MUSEUJI"
TOMBOL back
TOMBOL back
