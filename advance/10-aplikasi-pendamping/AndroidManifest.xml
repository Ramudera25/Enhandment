<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="id.musedroid.pendamping">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- WAJIB untuk ServerSocket lokal LayananLokal; tanpa ini bind() kena
         EACCES dan thread pendengar membunuh proses (terbukti 8 Okt 2026). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:label="muse-droid Pendamping"
        android:theme="@android:style/Theme.Material.Light">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".LayananLokal" android:exported="false" />
        <provider android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="id.musedroid.pendamping.shizuku"
            android:exported="true" android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
